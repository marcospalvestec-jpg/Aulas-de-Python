# EXERCÍCIO 04 — DOBRO, TRIPLO E METADE
#
# Enunciado:
# Leia um número real e mostre o dobro,
# o triplo e a metade desse valor.

numero = float(input("Digite um valor: "))

dobro = numero * 2
triplo = numero * 3
metade = numero / 2

print(f"Dobro: {dobro:g}")
print(f"Triplo: {triplo:g}")
print(f"Metade: {metade:g}")